[Unit]
Description=NOVA Watch headless SSH GPU collector
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=nova-collector
Group=nova-collector
WorkingDirectory=/opt/nova-collector
EnvironmentFile=/etc/nova-collector.env
ExecStart=/opt/nova-collector/nova-collector
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/nova-collector

[Install]
WantedBy=multi-user.target
