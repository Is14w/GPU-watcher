# Target GPU server reached from this collector over SSH.
NOVA_TARGET_HOST=192.0.2.10
NOVA_TARGET_PORT=22
NOVA_TARGET_USER=root

# privateKey or password
NOVA_TARGET_AUTH=privateKey
NOVA_TARGET_PRIVATE_KEY=~/.ssh/id_ed25519
NOVA_TARGET_PASSPHRASE=
# NOVA_TARGET_PASSWORD=

# Optional but recommended. If empty, the first successful connection is pinned
# to NOVA_DATA_DIR/known-host-*.txt and enforced on every later reconnect.
NOVA_TARGET_FINGERPRINT=

# Collection and reconnect policy.
NOVA_INTERVAL_MS=1000
NOVA_RECONNECT_MAX_SECONDS=30
NOVA_DATA_DIR=./data

# HTTP API. Keep the default loopback bind when using an SSH tunnel or reverse proxy.
NOVA_BIND=127.0.0.1:17841
# If set, /api/* requires Authorization: Bearer <token>. /health stays public.
NOVA_API_TOKEN=

RUST_LOG=nova_collector=info
