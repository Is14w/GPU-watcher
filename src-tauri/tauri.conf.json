{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NOVA Watch",
  "version": "0.1.0",
  "identifier": "dev.gpuwatcher.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NOVA Watch",
        "width": 1440,
        "height": 920,
        "minWidth": 1080,
        "minHeight": 720,
        "center": true,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#f8f3f7"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
